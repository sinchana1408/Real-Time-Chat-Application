# Application Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# For local Docker: postgresql://postgres:password@localhost:5432/pulsechat?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/pulsechat?schema=public

# Security & Authentication
JWT_SECRET=pulsechat_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# File Upload Configuration
# Options: 'local' | 'cloudinary'
UPLOAD_STORAGE_TYPE=local
UPLOAD_MAX_FILE_SIZE_MB=25

# Cloudinary Storage (Optional - used if UPLOAD_STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
